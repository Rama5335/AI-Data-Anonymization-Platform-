# Production environment variables for docker-compose.prod.yml.
# Copy this file to .env.prod and edit the values.

# MSSQL connection URL for the application database.
# This is the platform's own metadata DB — NOT the target you're anonymizing.
DATABASE_URL=mssql+pyodbc://sa:CHANGE_ME@mssql-host:1433/anonymizer_app?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# LLM model pulled in Ollama (local inference only).
OLLAMA_MODEL=qwen2.5:7b-instruct

# The platform only supports a local Ollama endpoint (or LLM_PROVIDER=mock
# for tests). Cloud providers are intentionally not supported.
LLM_PROVIDER=ollama

# Browser origin(s) allowed to call the API. Use your public HTTPS origin.
CORS_ORIGINS=https://anonymizer.example.com

# Backup retention (FIFO, keep last N)
BACKUP_KEEP=5

# Bootstrap admin credentials (created on first login if no users exist)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# These are set via Docker secrets (see README):
#   jwt_secret_key              → 32-byte hex string
#   credential_encryption_key   → 32-byte base64 string
#   mssql_sa_password           → DB password
