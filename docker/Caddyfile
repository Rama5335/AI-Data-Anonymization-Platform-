# Caddyfile for AI Data Anonymization Platform (production).
#
# Replace example.com with your actual domain. Caddy obtains and renews
# the TLS certificate automatically.
#
# Routing:
#   /api/*   -> backend:8765 (prefix stripped; backend routes have no /api)
#   /health* -> backend:8765
#   /*       -> frontend:5173 (static SPA; nginx also proxies /api/ as a
#               fallback when Caddy is not used)
#
# If you run on an internal network without a public DNS name, keep the
# :443 block below and use an internal CA / self-signed certificate.

# --- Option 1: Public domain with auto-TLS (recommended) ---
# example.com {
#     handle_path /api/* {
#         reverse_proxy backend:8765
#     }
#     handle /health* {
#         reverse_proxy backend:8765
#     }
#     handle {
#         reverse_proxy frontend:5173
#     }
#
#     @login path /auth/login
#     rate_limit @login {
#         zone login_limit {
#             key {remote_host}
#             events 10
#             window 1m
#         }
#     }
#
#     log {
#         output file /var/log/caddy/access.log
#     }
# }

# --- Option 2: Local / internal network ---
:443 {
    handle_path /api/* {
        reverse_proxy backend:8765
    }
    handle /health* {
        reverse_proxy backend:8765
    }
    handle {
        reverse_proxy frontend:5173
    }

    log {
        output stdout
        format json
    }
}

# HTTP -> HTTPS redirect
:80 {
    redir https://{host}{uri} permanent
}
