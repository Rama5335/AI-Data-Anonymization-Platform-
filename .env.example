APP_NAME=AI Data Anonymization Platform
APP_ENV=development
LOG_LEVEL=INFO

# --- Secrets (NEVER commit real values) ---
# JWT_SECRET_KEY signs access tokens. Use a long random string (e.g.
# `python -c "import secrets;print(secrets.token_urlsafe(48))"`).
JWT_SECRET_KEY=replace-with-a-strong-development-secret
# CREDENTIAL_ENCRYPTION_KEY encrypts stored connection strings. MUST be a
# 32-byte urlsafe-base64 value, e.g.
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Losing this key makes existing encrypted connection strings unreadable.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# --- Application metadata database (NOT the anonymization target) ---
DATABASE_URL=mssql+pyodbc://username:password@localhost:1433/anonymizer_app?driver=ODBC+Driver+18+for+SQL+Server

# --- LLM (local by default) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Set LLM_PROVIDER=openai to use the OpenAI Chat Completions API instead,
# or LLM_PROVIDER=mock for deterministic CI fixtures (no network).
LLM_PROVIDER=ollama
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Backup (mandatory before any real update) ---
# BACKUP_DIR must be a directory the API process can read/write and that the
# MSSQL instance can write backups into (the safe-update gate requires the
# verified .bak file to be visible here). Default: ./backups
BACKUP_DIR=./backups
# FIFO retention per database.
BACKUP_KEEP=5

# --- Safe update ---
# Rows per UPDATE batch.
SAFE_UPDATE_BATCH_SIZE=500

# --- Workflow / approval window ---
WORKFLOW_APPROVAL_TIMEOUT_HOURS=168

# --- First-run bootstrap (optional) ---
# If set, the first login creates this admin when the users table is empty.
# Remove these after the first successful login.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
